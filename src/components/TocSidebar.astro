---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  current: CollectionEntry<'modules'>;
}

const { current } = Astro.props;
const chapters = (await getCollection('modules')).sort((a, b) => a.data.order - b.data.order);
---

<aside class="toc-left" id="toc-left">
  <nav class="toc" id="left-toc" aria-label="章节目录">
    <button class="toc-toggle" id="toc-toggle" type="button" aria-expanded="true" aria-controls="toc-list">
      <span class="toc-toggle-bar" aria-hidden="true"></span>
      <span class="toc-toggle-label">章节目录</span>
      <svg class="toc-toggle-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
        <path d="M2.5 3.5L5 6.5L7.5 3.5" stroke="currentColor" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <ul class="toc-list" id="toc-list">
      {chapters.map((c) => (
        <li class:list={['toc-item', c.id === current.id && 'is-current']}>
          <a href={`/modules/${c.id}`}>
            <span class="toc-num">M{String(c.data.order).padStart(2, '0')}</span>
            <span class="toc-title">{c.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
<div class="drawer-backdrop" data-drawer-backdrop></div>
